<launch>
<!-- HKU Campus 数据集：沿用在 mapping_avia.launch 中修改，默认回放 datasets/hku_campus_seq_00.bag -->

	<arg name="rviz" default="true" />
	<arg name="highrate_odom" default="true" />
	<!-- 回放数据集：bag 路径、倍率、起始时间、延迟、播放时长 -->
	<arg name="bag"      default="$(find fast_lio)/../datasets/hku_campus_seq_00.bag"/>
	<arg name="rate"     default="1.0"/>
	<arg name="start"    default="0.0"/>
	<arg name="delay"    default="3.0"/>
	<arg name="duration" default="0.0"/>

	<rosparam command="load" file="$(find fast_lio)/config/avia.yaml" />
	<param name="publish/highrate_odom_en" type="bool" value="$(arg highrate_odom)" />
	<!-- 建图时持续发布累计轨迹，RViz 中可看到三维轨迹形状 -->
	<param name="publish/path_en" type="bool" value="true" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

	<include file="$(find fast_lio)/launch/play_bag.launch">
		<arg name="bag"      value="$(arg bag)"/>
		<arg name="rate"     value="$(arg rate)"/>
		<arg name="start"    value="$(arg start)"/>
		<arg name="delay"    value="$(arg delay)"/>
		<arg name="duration" value="$(arg duration)"/>
	</include>

</launch>
